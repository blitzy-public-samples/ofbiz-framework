# NON-SECRET settings for the compose example only.
#
# This file is tracked in the Apache OFBiz repository, so it deliberately declares NO password. A
# password published here would be a known credential in every checkout and in every deployment that
# copied the example unchanged. The seven passwords the example needs - the PostgreSQL superuser
# password, the three serving database passwords and the three schema-initialization database passwords
# - are therefore NOT declared in any tracked file. They are pulled from YOUR environment by the
# "${...:?}" required-variable references in docker-compose.yml, which refuses to start the stack until
# you supply them. See "Credentials of the compose example" in DOCKER.adoc for the two supported ways
# of supplying them.
#
# Docker Compose does NOT interpolate variables inside an env_file, so a "${...}" reference placed here
# would be passed to the container verbatim as the literal password text. Keep secrets out of this file.
#
# The three usernames below are the SERVING accounts: they may read and write rows and may not change
# the schema. The accounts that may change the schema are named in ofbiz-postgres-init.env, which the
# serving service is deliberately not given.

OFBIZ_POSTGRES_HOST=db

OFBIZ_POSTGRES_OFBIZ_DB=ofbizmaindb
OFBIZ_POSTGRES_OFBIZ_USER=ofbiz

OFBIZ_POSTGRES_OLAP_DB=ofbizolapdb
OFBIZ_POSTGRES_OLAP_USER=ofbizolap

OFBIZ_POSTGRES_TENANT_DB=ofbiztenantdb
OFBIZ_POSTGRES_TENANT_USER=ofbiztenant
